{
  "name": "own-keys",
  "statements": [
    {
      "effect": "EFFECT_ALLOW",
      "methods": ["within.website.x.iam.v1.KeyService/ListKeys"],
      "filter": "req.user_id == '' || req.user_id == principal.principal_id"
    },
    {
      "effect": "EFFECT_ALLOW",
      "methods": ["within.website.x.iam.v1.KeyService/CreateKey"],
      "filter": "req.user_id == principal.principal_id"
    }
  ]
}
